---
/**
 * Beranda — locale DEFAULT (id), TANPA prefix URL.
 * Isi komposisi ada di components/pages/HomeContent.astro yang
 * dipakai bersama wrapper /en. Pages/ hanya: layout + locale + komposisi.
 */
import HomeContent from '@/components/pages/HomeContent.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { tFactory, type Lang } from '@/i18n';

const lang: Lang = 'id';
const t = tFactory(lang);
---

<BaseLayout lang={lang} title={t('page.title.home')} description={t('page.description.home')}>
  <HomeContent lang={lang} />
</BaseLayout>
