---
import PrivacyContent from '@/components/pages/PrivacyContent.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { tFactory, type Lang } from '@/i18n';

const lang: Lang = 'id';
const t = tFactory(lang);
---

<BaseLayout
	lang={lang}
	title={t('page.title.privacy')}
	description={t('page.description.privacy')}
>
	<PrivacyContent lang={lang} />
</BaseLayout>