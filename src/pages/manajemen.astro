---
/**
 * /manajemen — locale default (id), tanpa prefix.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ManajemenContent from '@/components/pages/ManajemenContent.astro';
import { tFactory, type Lang } from '@/i18n';

const lang: Lang = 'id';
const t = tFactory(lang);
---

<BaseLayout
  lang={lang}
  title={t('page.title.manajemen')}
  description={t('page.description.manajemen')}
>
  <ManajemenContent lang={lang} />
</BaseLayout>
