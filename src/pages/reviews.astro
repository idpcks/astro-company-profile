---
import ReviewsContent from '@/components/pages/ReviewsContent.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { tFactory, type Lang } from '@/i18n';

const lang: Lang = 'id';
const t = tFactory(lang);

// CATATAN SEO: JSON-LD Review/AggregateRating sengaja TIDAK dipasang.
// Google tidak menampilkan rich result untuk "self-serving reviews"
// (rating organisasi tentang dirinya sendiri) dan berisiko melanggar
// kebijakan structured data. Testimoni tetap tampil sebagai konten
// halaman dari SOT src/data/testimonials.ts.
---

<BaseLayout lang={lang} title={t('page.title.reviews')} description={t('page.description.reviews')}>
  <ReviewsContent lang={lang} />
</BaseLayout>
