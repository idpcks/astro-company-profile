---
import FaqContent from '@/components/pages/FaqContent.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { tFactory, type Lang } from '@/i18n';

const lang: Lang = 'id';
const t = tFactory(lang);

// FAQPage schema untuk SEO
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: 'Apa saja layanan yang tersedia di RS Krakatau Medika?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'RS Krakatau Medika menyediakan layanan IGD 24 jam, poliklinik spesialis, rawat inap, bedah sentral, laboratorium & radiologi, dan medical checkup.',
			},
		},
		{
			'@type': 'Question',
			name: 'Bagaimana cara membuat janji temu?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Anda dapat membuat janji temu melalui telepon di (0254) 396333, atau datang langsung ke loket pendaftaran rumah sakit.',
			},
		},
		{
			'@type': 'Question',
			name: 'Berapa jam operasional poliklinik?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Poliklinik beroperasi Senin–Minggu pukul 08.00–23.00 WIB. IGD tersedia 24 jam setiap hari.',
			},
		},
		{
			'@type': 'Question',
			name: 'Apakah RS Krakatau Medika menerima BPJS Kesehatan?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Ya, RS Krakatau Medika merupakan mitra BPJS Kesehatan. Silakan bawa kartu BPJS Anda saat kunjungan.',
			},
		},
		{
			'@type': 'Question',
			name: 'Di mana saya bisa menemukan informasi tentang klinik satellite?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Informasi tentang klinik di Cilegon dan Serang tersedia di halaman Klinik. Kunjungi halaman Klinik untuk detail alamat dan jam operasional.',
			},
		},
		{
			'@type': 'Question',
			name: 'Bagaimana cara menghubungi RS Krakatau Medika untuk keadaan darurat?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Untuk keadaan darurat, silakan hubungi IGD darurat di (0254) 396333 atau kunjungi rumah sakit langsung.',
			},
		},
	],
};
---

<BaseLayout
	lang={lang}
	title={t('page.title.faq')}
	description={t('page.description.faq')}
	jsonLd={faqSchema}
>
	<FaqContent lang={lang} />
</BaseLayout>