---
const lang = (Astro.currentLocale as 'id' | 'en') || 'id';

import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
---

<BaseLayout noindex lang={lang} title="500 — Kesalahan Server" description="Terjadi kesalahan internal server.">
	<section class="section">
		<div class="container notfound">
			<p class="notfound__code" aria-hidden="true">500</p>
			<h1 class="notfound__title">
				{lang === 'en' ? 'Internal Server Error' : 'Kesalahan Server Internal'}
			</h1>
			<p class="notfound__lead">
				{lang === 'en'
					? 'Something went wrong on our end. Please try again later.'
					: 'Terjadi kesalahan di sistem kami. Silakan coba lagi nanti.'}
			</p>
			<div class="notfound__actions">
				<Button href={lang === 'en' ? '/en' : '/'}>
					{lang === 'en' ? '← Home' : '← Beranda'}
				</Button>
				<Button href={lang === 'en' ? '/en/contact' : '/contact'} variant="outline">
					{lang === 'en' ? 'Contact Support' : 'Hubungi Dukungan'}
				</Button>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.notfound {
		text-align: center;
		max-width: 36rem;
	}

	.notfound__code {
		font-size: var(--text-5xl);
		font-weight: 700;
		color: var(--color-emergency);
		letter-spacing: 0.1em;
	}

	.notfound__title {
		font-size: var(--text-2xl);
		margin-top: var(--space-2);
	}

	.notfound__lead {
		color: var(--color-muted);
		margin-top: var(--space-3);
	}

	.notfound__actions {
		display: flex;
		justify-content: center;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}
</style>