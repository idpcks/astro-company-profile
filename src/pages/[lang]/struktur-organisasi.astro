---
/**
 * /en/struktur-organisasi — halaman struktur-organisasi dalam bahasa Inggris.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import StrukturOrganisasiContent from '@/components/pages/StrukturOrganisasiContent.astro';
import { tFactory, type Lang } from '@/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }];
}

const lang: Lang = 'en';
const t = tFactory(lang);
---

<BaseLayout
  lang={lang}
  title={t('page.title.strukturOrganisasi')}
  description={t('page.description.strukturOrganisasi')}
>
  <StrukturOrganisasiContent lang={lang} />
</BaseLayout>
