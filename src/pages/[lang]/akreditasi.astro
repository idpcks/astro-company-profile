---
/**
 * /en/akreditasi — halaman akreditasi dalam bahasa Inggris.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import AkreditasiContent from '@/components/pages/AkreditasiContent.astro';
import { tFactory, type Lang } from '@/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }];
}

const lang: Lang = 'en';
const t = tFactory(lang);
---

<BaseLayout
  lang={lang}
  title={t('page.title.akreditasi')}
  description={t('page.description.akreditasi')}
>
  <AkreditasiContent lang={lang} />
</BaseLayout>
