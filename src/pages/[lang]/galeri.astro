---
/**
 * /en/galeri — halaman Galeri dalam bahasa Inggris.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import GaleriContent from '@/components/pages/GaleriContent.astro';
import { tFactory, type Lang } from '@/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }];
}

const lang: Lang = 'en';
const t = tFactory(lang);
---

<BaseLayout lang={lang} title={t('page.title.galeri')} description={t('page.description.galeri')}>
  <GaleriContent lang={lang} />
</BaseLayout>
