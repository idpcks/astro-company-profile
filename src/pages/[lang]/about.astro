---
/**
 * /en/about — halaman Tentang Kami dalam bahasa Inggris.
 */
import AboutContent from '@/components/pages/AboutContent.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { tFactory, type Lang } from '@/i18n';

export function getStaticPaths() {
	return [{ params: { lang: 'en' } }];
}

const lang: Lang = 'en';
const t = tFactory(lang);
---

<BaseLayout
	lang={lang}
	title={t('page.title.about')}
	description={t('page.description.about')}
>
	<AboutContent lang={lang} />
</BaseLayout>
