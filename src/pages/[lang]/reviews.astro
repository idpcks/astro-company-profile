---
import ReviewsContent from '@/components/pages/ReviewsContent.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { tFactory, type Lang } from '@/i18n';

export function getStaticPaths() {
	return [{ params: { lang: 'en' } }];
}

const lang: Lang = 'en';
const t = tFactory(lang);

// Review schema untuk SEO (English)
const reviewSchema = {
	'@context': 'https://schema.org',
	'@type': 'AggregateRating',
	itemReviewed: {
		'@type': 'MedicalOrganization',
		name: 'RS Krakatau Medika',
	},
	ratingValue: '4.8',
	bestRating: '5',
	worstRating: '1',
	reviewCount: '3',
	description: 'Patient testimonials about their experience at RS Krakatau Medika.',
	review: [
		{
			'@type': 'Review',
			author: { '@type': 'Person', name: 'Sari Wulandari' },
			reviewRating: { '@type': 'Rating', ratingValue: '5' },
			reviewBody: 'The ER service was fast and calm. The doctors and nurses communicated clearly from admission until we went home.',
		},
		{
			'@type': 'Review',
			author: { '@type': 'Person', name: 'Budi Santoso' },
			reviewRating: { '@type': 'Rating', ratingValue: '5' },
			reviewBody: 'My child stayed in a class-2 room and the care was outstanding. Clean rooms, modern facilities.',
		},
		{
			'@type': 'Review',
			author: { '@type': 'Person', name: 'Dewi Lestari' },
			reviewRating: { '@type': 'Rating', ratingValue: '5' },
			reviewBody: 'Booking by phone was easy, the checkup results came quickly and were explained in detail.',
		},
	],
};
---

<BaseLayout
	lang={lang}
	title={t('page.title.reviews')}
	description={t('page.description.reviews')}
	jsonLd={reviewSchema}
>
	<ReviewsContent lang={lang} />
</BaseLayout>