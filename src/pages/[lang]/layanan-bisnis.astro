---
/**
 * /en/layanan-bisnis — halaman Layanan Bisnis dalam bahasa Inggris.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import BisnisContent from '@/components/pages/BisnisContent.astro';
import { tFactory, type Lang } from '@/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }];
}

const lang: Lang = 'en';
const t = tFactory(lang);
---

<BaseLayout
  lang={lang}
  title={t('page.title.layananBisnis')}
  description={t('page.description.layananBisnis')}
>
  <BisnisContent lang={lang} />
</BaseLayout>
