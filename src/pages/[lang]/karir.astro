---
/**
 * /en/karir — halaman Karir dalam bahasa Inggris.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import KarirContent from '@/components/pages/KarirContent.astro';
import { tFactory, type Lang } from '@/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }];
}

const lang: Lang = 'en';
const t = tFactory(lang);
---

<BaseLayout lang={lang} title={t('page.title.karir')} description={t('page.description.karir')}>
  <KarirContent lang={lang} />
</BaseLayout>
