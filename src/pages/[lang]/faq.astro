---
import FaqContent from '@/components/pages/FaqContent.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localized, tFactory, type Lang } from '@/i18n';
import { FAQ_ITEMS } from '@/data/faq';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }];
}

const lang: Lang = 'en';
const t = tFactory(lang);

// FAQPage schema untuk SEO (English) — teks diambil dari SOT
// src/data/faq.ts agar IDENTIK dengan konten terlihat.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ_ITEMS.map((item) => ({
    '@type': 'Question',
    name: localized(item.question, lang),
    acceptedAnswer: {
      '@type': 'Answer',
      text: localized(item.answer, lang),
    },
  })),
};
---

<BaseLayout
  lang={lang}
  title={t('page.title.faq')}
  description={t('page.description.faq')}
  jsonLd={faqSchema}
>
  <FaqContent lang={lang} />
</BaseLayout>
