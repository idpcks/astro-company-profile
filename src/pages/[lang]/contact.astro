---
/**
 * /en/contact — halaman Kontak dalam bahasa Inggris.
 */
import ContactContent from '@/components/pages/ContactContent.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { tFactory, type Lang } from '@/i18n';

export function getStaticPaths() {
	return [{ params: { lang: 'en' } }];
}

const lang: Lang = 'en';
const t = tFactory(lang);
---

<BaseLayout
	lang={lang}
	title={t('page.title.contact')}
	description={t('page.description.contact')}
>
	<ContactContent lang={lang} />
</BaseLayout>
