---
/**
 * /en/kemitraan — halaman kemitraan dalam bahasa Inggris.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import KemitraanContent from '@/components/pages/KemitraanContent.astro';
import { tFactory, type Lang } from '@/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }];
}

const lang: Lang = 'en';
const t = tFactory(lang);
---

<BaseLayout
  lang={lang}
  title={t('page.title.kemitraan')}
  description={t('page.description.kemitraan')}
>
  <KemitraanContent lang={lang} />
</BaseLayout>
