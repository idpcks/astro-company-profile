---
/**
 * /en/profil — halaman Profil dalam bahasa Inggris.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProfilContent from '@/components/pages/ProfilContent.astro';
import { tFactory, type Lang } from '@/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }];
}

const lang: Lang = 'en';
const t = tFactory(lang);
---

<BaseLayout lang={lang} title={t('page.title.profil')} description={t('page.description.profil')}>
  <ProfilContent lang={lang} />
</BaseLayout>
