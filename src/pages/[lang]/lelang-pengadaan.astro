---
/**
 * /en/lelang-pengadaan — halaman Lelang & Pengadaan dalam bahasa Inggris.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import LelangPengadaanContent from '@/components/pages/LelangPengadaanContent.astro';
import { tFactory, type Lang } from '@/i18n';

export function getStaticPaths() {
	return [{ params: { lang: 'en' } }];
}

const lang: Lang = 'en';
const t = tFactory(lang);
---

<BaseLayout
	lang={lang}
	title={t('page.title.lelangPengadaan')}
	description={t('page.description.lelangPengadaan')}
>
	<LelangPengadaanContent lang={lang} />
</BaseLayout>