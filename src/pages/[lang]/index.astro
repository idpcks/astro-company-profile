---
/**
 * /en — beranda English. Wrapper [lang] untuk locale berprefix.
 */
import HomeContent from '@/components/pages/HomeContent.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { tFactory, type Lang } from '@/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }];
}

const lang: Lang = 'en';
const t = tFactory(lang);
---

<BaseLayout lang={lang} title={t('page.title.home')} description={t('page.description.home')}>
  <HomeContent lang={lang} />
</BaseLayout>
