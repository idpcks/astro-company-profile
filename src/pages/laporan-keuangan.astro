---
/**
 * /laporan-keuangan — locale default (id), tanpa prefix.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import LaporanKeuanganContent from '@/components/pages/LaporanKeuanganContent.astro';
import { tFactory, type Lang } from '@/i18n';

const lang: Lang = 'id';
const t = tFactory(lang);
---

<BaseLayout
	lang={lang}
	title={t('page.title.laporanKeuangan')}
	description={t('page.description.laporanKeuangan')}
>
	<LaporanKeuanganContent lang={lang} />
</BaseLayout>