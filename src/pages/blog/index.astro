---
/**
 * /blog — listing artikel, locale default (id).
 * Query lewat lib/blog.ts (TIDAK getCollection langsung) supaya
 * logika pairing bilingual ada di satu tempat.
 */
import PostCard from '@/components/blog/PostCard.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import PageHero from '@/components/ui/PageHero.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPostsForListing } from '@/lib/blog';
import { localePath, tFactory, type Lang } from '@/i18n';

const lang: Lang = 'id';
const t = tFactory(lang);

const posts = await getPostsForListing(lang);
---

<BaseLayout lang={lang} title={t('page.title.blog')} description={t('page.description.blog')}>
  <PageHero
    eyebrow={t('pagehero.eyebrow.blog')}
    title={t('blogPage.hero.title')}
    lead={t('blogPage.hero.lead')}
  />

  <section class="section">
    <div class="container">
      {
        posts.length > 0 ? (
          <div class="blog-list">
            {posts.map((post) => (
              <PostCard post={post} lang={lang} />
            ))}
          </div>
        ) : (
          <EmptyState
            icon="book-open"
            title={t('blog.empty.title')}
            description={t('blog.empty.description')}
            actionText={t('blog.empty.action')}
            actionHref={localePath('/', lang)}
          />
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .blog-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-6);
  }
</style>
