---
/**
 * SidebarCta — ajakan bertindak di sidebar artikel.
 *
 * Pembaca artikel kesehatan = calon pasien: berikan jalur kontak tercepat.
 * Data diambil dari SITE/SOCIAL_LINKS (single source of truth) + jam
 * layanan per locale. Link /contact dibuat locale-aware (localePath).
 *
 * DESAIN: kartu CTA utama — bagian paling prominent di sidebar. Surface
 * tinted (primary-light), radius-lg, elevasi sangat rendah. Hierarki aksi:
 * WhatsApp = tombol primary penuh, Telepon & Hubungi Kami = tautan
 * sekunder ringan (visual weight tidak disamakan).
 */
import { SITE, SOCIAL_LINKS } from '@/data/site';
import type { Lang } from '@/i18n';
import { localePath, tFactory } from '@/i18n';
import { Icon } from 'astro-icon/components';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;
const t = tFactory(lang);
const title = t('sidebar.cta.title');
const waHref = SOCIAL_LINKS.find((s) => s.label.toLowerCase().includes('whatsapp'))?.href;
const phoneHref = `tel:${SITE.phone.replace(/\s/g, '')}`;
---

<aside class="cta-card" aria-label={title}>
  <h2 class="cta-card__title">{title}</h2>
  <p class="cta-card__lead">{t('sidebar.cta.lead')}</p>
  <p class="cta-card__hours">{SITE.hours[lang]}</p>

  {
    waHref && (
      <a class="cta-card__primary" href={waHref} target="_blank" rel="noopener">
        <Icon name="lucide:message-circle" class="cta__icon" aria-hidden="true" />
        {t('sidebar.cta.whatsapp')}
      </a>
    )
  }

  <div class="cta-card__secondary">
    <a class="cta-card__link" href={phoneHref}>
      <Icon name="lucide:phone" class="cta__icon" aria-hidden="true" />
      {t('sidebar.cta.call')}
    </a>
    <span class="cta-card__dot" aria-hidden="true">·</span>
    <a class="cta-card__link" href={localePath('/contact', lang)}>
      <Icon name="lucide:contact" class="cta__icon" aria-hidden="true" />
      {t('sidebar.cta.contact')}
    </a>
  </div>
</aside>

<style>
  .cta-card {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-6);
    background-color: var(--color-primary-light);
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .cta-card__title {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-ink);
  }

  .cta-card__lead {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .cta-card__hours {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary-text);
  }

  /* Ukuran & perilaku ikon secara umum di dalam kartu ini */
  .cta__icon {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
  }

  /* Aksi utama: tombol pill primary, selebar kartu — ikon sejajar teks */
  .cta-card__primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-full);
    background-color: var(--color-primary);
    color: #ffffff;
    font-weight: 600;
    font-size: var(--text-sm);
    text-align: center;
    text-decoration: none;
    transition: background-color var(--transition-base);
  }

  .cta-card__primary:hover {
    background-color: var(--color-primary-dark);
  }

  /* Aksi sekunder: tautan ringan — visual weight sengaja lebih kecil */
  .cta-card__secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
  }

  .cta-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color var(--transition-base);
  }

  .cta-card__link:hover {
    color: var(--color-primary-text);
  }

  .cta-card__dot {
    font-size: var(--text-sm);
    color: var(--color-border);
  }
</style>
