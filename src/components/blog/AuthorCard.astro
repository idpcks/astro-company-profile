---
/**
 * AuthorCard — penulis & tanggal di sidebar artikel.
 *
 * Membangun kredibilitas: siapa yang menulis/meninjau artikel dan kapan.
 * Avatar berbentuk lingkaran berisi inisial — sumber terbatas, jadi foto
 * riil belum disediakan (ganti dengan <SiteImage> bila memungkinkan).
 *
 * DESAIN: panel halus netral (surface-alt) — senada elevasinya dengan kartu
 * CTA, tanpa border yang mencolok. Hierarchy: avatar → label small-caps →
 * nama → tanggal ber-ikon.
 */
import { Icon } from 'astro-icon/components';
import type { Lang } from '@/i18n';
import { tFactory } from '@/i18n';

interface Props {
  author?: string;
  pubDate: Date;
  lang?: Lang;
}

const { author, pubDate, lang = 'id' } = Astro.props;
const t = tFactory(lang);

const locale = lang === 'en' ? 'en-US' : 'id-ID';
const published = pubDate.toLocaleDateString(locale, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const name = author ?? '';
const initial = name.trim().charAt(0)?.toUpperCase() ?? '?';

// Warna avatar deterministik dari nama — konsisten antar halaman.
const hues = [190, 210, 230, 160, 260];
const hash = [...name].reduce((acc, ch) => acc + ch.charCodeAt(0), 0);
const hue = hues[hash % hues.length];
---

<aside class="author-card" aria-label={name ? t('post.writtenBy') : t('post.publishedLabel')}>
  <span class="author-card__avatar" style={`background: hsl(${hue} 45% 45%)`} aria-hidden="true">
    {initial}
  </span>
  <div class="author-card__info">
    {name && <p class="author-card__label">{t('post.writtenBy')}</p>}
    {name && <p class="author-card__name">{author}</p>}
    <p class="author-card__date">
      <Icon name="lucide:calendar" class="author-card__icon" aria-hidden="true" />
      <time datetime={pubDate.toISOString()}>{published}</time>
    </p>
  </div>
</aside>

<style>
  /* Panel halus netral — gaya senada dengan kartu CTA (dekat elevasinya) */
  .author-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    background-color: var(--color-surface-alt);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .author-card__avatar {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-full);
    color: #ffffff;
    font-weight: 700;
    font-size: var(--text-lg);
  }

  .author-card__info {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }

  .author-card__label {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .author-card__name {
    margin: 0;
    font-weight: 700;
    font-size: var(--text-base);
    color: var(--color-ink);
    line-height: var(--leading-tight);
  }

  .author-card__date {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .author-card__icon {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
  }
</style>
