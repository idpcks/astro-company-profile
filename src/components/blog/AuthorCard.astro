---
/**
 * AuthorCard — penulis & tanggal di sidebar artikel.
 *
 * Membangun kredibilitas: siapa yang menulis/meninjau artikel dan kapan.
 * Avatar berbentuk lingkaran berisi inisial — sumber terbatas, jadi foto
 * riil belum disediakan (ganti dengan <SiteImage> bila memungkinkan).
 *
 * DESAIN: bagian dari "rail" kontinyu sidebar — tanpa kotak; dipisah dari
 * Daftar Isi hanya oleh hairline tipis. Hierarchy: label small-caps →
 * nama → tanggal.
 */
import type { Lang } from '@/i18n';
import { tFactory } from '@/i18n';

interface Props {
	author?: string;
	pubDate: Date;
	lang?: Lang;
}

const { author, pubDate, lang = 'id' } = Astro.props;
const t = tFactory(lang);

const locale = lang === 'en' ? 'en-US' : 'id-ID';
const published = pubDate.toLocaleDateString(locale, {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});

const name = author ?? '';
const initial = name.trim().charAt(0)?.toUpperCase() ?? '?';

// Warna avatar deterministik dari nama — konsisten antar halaman.
const hues = [190, 210, 230, 160, 260];
const hash = [...name].reduce((acc, ch) => acc + ch.charCodeAt(0), 0);
const hue = hues[hash % hues.length];
---

<aside class="author" aria-label={name ? t('post.writtenBy') : t('post.publishedLabel')}>
	<span class="author__avatar" style={`background: hsl(${hue} 45% 45%)`} aria-hidden="true">
		{initial}
	</span>
	<div class="author__info">
		{name && <p class="author__label">{t('post.writtenBy')}</p>}
		{name && <p class="author__name">{author}</p>}
		<p class="author__date">
			<time datetime={pubDate.toISOString()}>{published}</time>
		</p>
	</div>
</aside>

<style>
	.author {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding-block: var(--space-4);
		border-top: 1px solid var(--color-border);
	}

	.author__avatar {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: var(--radius-full);
		color: #ffffff;
		font-weight: 700;
		font-size: var(--text-base);
	}

	.author__info {
		display: grid;
		gap: 0.125rem;
		min-width: 0;
	}

	.author__label {
		margin: 0;
		font-size: var(--text-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-muted);
	}

	.author__name {
		margin: 0;
		font-weight: 600;
		color: var(--color-ink);
		line-height: var(--leading-tight);
	}

	.author__date {
		margin: 0;
		font-size: var(--text-xs);
		color: var(--color-muted);
	}
</style>