---
/**
 * ArticleToc — Daftar Isi di sidebar artikel.
 *
 * Ditengarai dari array `headings` yang dikembalikan `render()` di halaman
 * detail (depth 2/3 = h2/h3 di Markdown). Setiap item jadi anchor `<a href="#slug">`
 * — heading hasil render Astro sudah otomatis diberi `id` yang sama dengan `slug`.
 * Tidak dirender bila artikel terlalu pendek (< 2 heading).
 *
 * DESAIN: bagian dari "rail" kontinyu sidebar — tanpa kotak. Label small-caps
 * + daftar teks dengan indikator garis vertikal tipis di kiri item.
 */
import { Icon } from 'astro-icon/components';
import type { Lang } from '@/i18n';
import { tFactory } from '@/i18n';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  lang?: Lang;
}

const { headings, lang = 'id' } = Astro.props;
const items = headings.filter((h: Heading) => h.depth >= 2 && h.depth <= 3);
const t = tFactory(lang);
const title = t('toc.title');
---

{
  items.length > 1 && (
    <nav class="toc" aria-label={title}>
      <h2 class="toc__title">
        <Icon name="lucide:book-open" class="toc__icon" aria-hidden="true" />
        {title}
      </h2>
      <ol class="toc__list">
        {items.map((h: Heading) => (
          <li class:list={['toc__item', { 'toc__item--sub': h.depth === 3 }]}>
            <a class="toc__link" href={`#${h.slug}`}>
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  :global(.toc__icon) {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
  }

  .toc__list {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .toc__item--sub {
    padding-left: var(--space-4);
  }

  .toc__link {
    display: block;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-3);
    border-left: 2px solid var(--color-border);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--color-muted);
    text-decoration: none;
    line-height: var(--leading-tight);
    transition:
      color var(--transition-base),
      border-color var(--transition-base),
      background-color var(--transition-base);
  }

  .toc__link:hover {
    background-color: var(--color-primary-light);
    border-left-color: var(--color-primary-text);
    color: var(--color-primary-text);
  }
</style>
