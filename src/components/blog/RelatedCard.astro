---
/**
 * RelatedCard — kartu KOMPAK untuk daftar "Artikel Terkait".
 *
 * Berbeda dari PostCard (kartu besar berisi tag + deskripsi): komponen
 * ini baris ramping — thumbnail kecil di kiri, judul (maks 2 baris) +
 * meta di kanan. Seluruh item berupa <a> link.
 *
 * CATATAN scoping: <a> dibuat langsung di komponen ini → selector scoped
 * berlaku. Thumbnail dirender SiteImage (komponen lain, tanpa scope id)
 * → gaya img wajib :global() — gotcha yang sama seperti cover artikel.
 */
import PostMeta from '@/components/blog/PostMeta.astro';
import SiteImage from '@/components/ui/SiteImage.astro';
import type { Lang } from '@/i18n';
import type { NormalizedPost } from '@/lib/blog';

interface Props {
  post: NormalizedPost;
  lang?: Lang;
}

const { post, lang = 'id' } = Astro.props;
const { title, pubDate, author, url, image } = post;
---

<a class="related-card" href={url}>
  {
    image && (
      <SiteImage
        src={image}
        alt=""
        width={176}
        height={99}
        loading="lazy"
        class="related-card__thumb"
      />
    )
  }
  <span class="related-card__body">
    <span class="related-card__title">{title}</span>
    <PostMeta pubDate={pubDate} author={author} lang={lang} class="related-card__meta" />
  </span>
</a>

<style>
  .related-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base),
      border-color var(--transition-base);
  }

  .related-card:hover {
    border-color: var(--color-primary-light);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  /* Thumbnail 16:9 kecil — img dirender SiteImage → wajib :global */
  :global(.related-card__thumb) {
    flex-shrink: 0;
    width: 88px;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .related-card__body {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .related-card__title {
    font-weight: 600;
    line-height: var(--leading-tight);
    /* clamp 2 baris agar baris kartu tetap ramping */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.related-card__meta) {
    font-size: var(--text-xs);
  }
</style>
