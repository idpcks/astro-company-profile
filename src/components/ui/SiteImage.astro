---
/**
 * SiteImage — SATU-SATUNYA titik pemuatan gambar di situs (SOT).
 *
 * Mendukung dua macam sumber:
 *   1. ImageMetadata  → <Image /> astro:assets: resize, format WebP/AVIF,
 *                       srcset responsif (widths/sizes), anti-layout-shift.
 *   2. string (URL)   → <img> murni (mis. frontmatter blog `image:` yang
 *                       belum bisa dioptimasi astro:assets). width/height
 *                       wajib dikirim pemanggil supaya tidak layout-shift.
 *
 * Kebijakan default: lazy + decoding async + format webp. Elemen LCP
 * (hero/cover above-the-fold) tinggal override `loading="eager"`.
 *
 * PENGAMAN CLS: jalur string (URL) WAJIB mengirim width+height — build
 * gagal (error) jika dilanggar, supaya layout shift dari gambar tak
 * pernah lolos ke production. Jalur ImageMetadata tidak butuh karena
 * astro:assets membaca dimensi dari metadata file.
 */
import { Image } from 'astro:assets';

export interface Props {
	src: ImageMetadata | string;
	alt: string;
	loading?: 'lazy' | 'eager';
	fetchpriority?: 'high' | 'low';
	/** Wajib untuk src string (URL) — pemicu CLS bila diabaikan. */
	width?: number;
	height?: number;
	widths?: number[];
	sizes?: string;
	format?: 'webp' | 'avif';
	class?: string;
}

const {
	src,
	alt,
	loading = 'lazy',
	fetchpriority,
	width,
	height,
	widths = [640, 768, 1024, 1280],
	sizes = 'min(100vw, 1200px)',
	format = 'webp',
	class: className,
} = Astro.props;

// Pengaman CLS: jalur URL tanpa dimensi = build error, buka jalan
// gambar yang lari-lari ke production.
if (typeof src === 'string' && (typeof width !== 'number' || typeof height !== 'number')) {
	throw new Error(
		`SiteImage: src string (URL) "${src}" butuh width & height bertipe number — cegah CLS. ` +
			`Gunakan <SiteImage src="..." width={1200} height={630} />.`
	);
}
---

{
	typeof src === 'string' ? (
		<img
			src={src}
			alt={alt}
			width={width}
			height={height}
			loading={loading}
			fetchpriority={fetchpriority}
			decoding="async"
			class={className}
		/>
	) : (
		<Image
			src={src}
			alt={alt}
			loading={loading}
			fetchpriority={fetchpriority}
			widths={widths}
			sizes={sizes}
			format={format}
			decoding="async"
			class={className}
		/>
	)
}