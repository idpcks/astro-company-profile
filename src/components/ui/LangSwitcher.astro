---
/**
 * LangSwitcher — tautan ke padanan halaman ini di locale lain.
 *
 * Membaca Astro.url.pathname sendiri → tidak butuh props locale,
 * bisa ditaruh di mana pun. Menampilkan KODE locale tujuan
 * ("EN" / "ID"), bukan nama panjang — pola umum di situs multibahasa.
 *
 * FALLBACK ARTIKEL (khusus blog bilingual): di halaman detail
 * /blog/<slug> yang belum punya terjemahan di locale tujuan, link
 * menunjuk ke LISTING blog locale tujuan — bukan ke URL 404.
 * Slug disamakan antar locale, jadi cukup dari path.
 *
 * URL strategy (astro.config.mjs): id tanpa prefix, en berprefix.
 * alternatePath() menghitung path padanan; hreflang memberi info
 * bahasa target ke browser & mesin pencari.
 */
import { alternatePath, languages, tFactory, type Lang } from '@/i18n';
import { getPostBySlug } from '@/lib/blog';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const { pathname } = Astro.url;
const [, maybeLang] = pathname.split('/');
const currentLang: Lang = maybeLang in languages ? (maybeLang as Lang) : 'id';
const targetLang: Lang = currentLang === 'id' ? 'en' : 'id';

const t = tFactory(currentLang);

// ── Deteksi halaman detail artikel ──
// Path dinormalisasi dulu (buang prefix locale), lalu cocokkan
// pola "/blog/<slug>". Slug sama antar locale (konvensi bilingual).
const segments = pathname.split('/').filter(Boolean);
const isPrefixed = segments.length > 0 && segments[0] in languages;
const cleanSegments = isPrefixed ? segments.slice(1) : segments;
const isPostDetail = cleanSegments[0] === 'blog' && cleanSegments.length === 2;
const postSlug = isPostDetail ? cleanSegments[1] : undefined;

// Kalau detail artikel & versi targetLang tidak ada → fallback ke listing.
let href = alternatePath(pathname, targetLang);
if (postSlug) {
  const target = await getPostBySlug(postSlug, targetLang);
  if (!target || target.isFallback) {
    href = alternatePath('/blog', targetLang);
  }
}
---

<a
  href={href}
  hreflang={targetLang}
  aria-label={t('lang.switch.aria')}
  title={languages[targetLang]}
  class:list={['lang-switcher', className]}
>
  {targetLang.toUpperCase()}
</a>

<style>
  /* Tinggi & gaya disamakan dengan ThemeToggle supaya klaster
	   aksi header terlihat sebagai satu keluarga kontrol. */
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.5rem;
    padding-inline: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-body);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition:
      color var(--transition-base),
      border-color var(--transition-base),
      background-color var(--transition-base);
  }

  .lang-switcher:hover {
    color: var(--color-primary-text);
    border-color: var(--color-primary-text);
    background-color: var(--color-primary-light);
  }
</style>
