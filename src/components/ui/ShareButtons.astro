---
/**
 * ShareButtons — widget bagikan ke sosial media (termasuk WhatsApp).
 *
 * Pola: link share resmi tiap platform, dibuka di tab baru, di-build
 * build-time (URL sudah di-encode). Tombol "Salin tautan" butuh JS —
 * script inline memakai data-attribute (pola yang sama seperti
 * skeleton-demo: string i18n dibawa build-time, bukan panggil t()).
 *
 * I18N: menerima `lang` untuk label/aria/title; konten dibagikan tetap
 * sesuai prop title (sudah diterjemahkan oleh pemanggil).
 */
import { tFactory, type Lang } from '@/i18n';

interface Props {
  /** Judul/teks yang dibagikan (sudah diterjemahkan pemanggil). */
  title?: string;
  /** URL absolut halaman yang dibagikan. Default: URL kanonik halaman. */
  url?: string;
  lang?: Lang;
}

const { title = '', url, lang = 'id' } = Astro.props;
const t = tFactory(lang);

// URL yang dibagikan: prop pemanggil, atau path halaman yang sedang
// dibuka terhadap Astro.site (kanonik).
const shareURL = url ?? new URL(Astro.url.pathname, Astro.site).href;
const enc = (s: string) => encodeURIComponent(s);
const textAndUrl = `${title} — ${shareURL}`;

// Markup isi <svg> 24×24 — path brand (fill) atau ikon UI (stroke).
const ICONS = {
  whatsapp:
    '<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>',
  facebook:
    '<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>',
  x: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>',
  telegram:
    '<path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.652-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>',
  linkedin:
    '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>',
  email:
    '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  copy: '<rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>',
  check: '<polyline points="20 6 9 17 4 12"/>',
};

// Jenis ikon: brand = fill (currentColor), ui = stroke (2px).
const FILL_ICONS = new Set(['whatsapp', 'facebook', 'x', 'telegram', 'linkedin']);

const NETWORKS = [
  { id: 'whatsapp', label: t('share.whatsapp'), href: `https://wa.me/?text=${enc(textAndUrl)}` },
  {
    id: 'facebook',
    label: t('share.facebook'),
    href: `https://www.facebook.com/sharer/sharer.php?u=${enc(shareURL)}`,
  },
  {
    id: 'x',
    label: t('share.x'),
    href: `https://twitter.com/intent/tweet?text=${enc(title)}&url=${enc(shareURL)}`,
  },
  {
    id: 'telegram',
    label: t('share.telegram'),
    href: `https://t.me/share/url?url=${enc(shareURL)}&text=${enc(title)}`,
  },
  {
    id: 'linkedin',
    label: t('share.linkedin'),
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(shareURL)}`,
  },
  {
    id: 'email',
    label: t('share.email'),
    href: `mailto:?subject=${enc(title)}&body=${enc(textAndUrl)}`,
  },
] as const;
---

<section class="share" data-share-root aria-label={t('share.title')}>
  <span class="share__title">{t('share.title')}</span>
  <ul class="share__list">
    {
      NETWORKS.map((network) => (
        <li>
          <a
            class:list={['share__button', `share__button--${network.id}`]}
            href={network.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={network.label}
            title={network.label}
          >
            <svg
              class="share__icon"
              viewBox="0 0 24 24"
              fill={FILL_ICONS.has(network.id) ? 'currentColor' : 'none'}
              stroke={FILL_ICONS.has(network.id) ? 'none' : 'currentColor'}
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <Fragment set:html={ICONS[network.id]} />
            </svg>
          </a>
        </li>
      ))
    }
    <li>
      <button
        class="share__button share__button--copy"
        type="button"
        data-share-copy
        data-url={shareURL}
        data-label={t('share.copy')}
        data-copied-label={t('share.copied')}
        aria-label={t('share.copy')}
        title={t('share.copy')}
      >
        <svg
          class="share__icon share__icon--clip"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <Fragment set:html={ICONS.copy} />
        </svg>
        <svg
          class="share__icon share__icon--check"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <Fragment set:html={ICONS.check} />
        </svg>
      </button>
    </li>
  </ul>
</section>

<style>
  .share {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .share__title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-muted);
  }

  .share__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .share__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-full);
    color: #ffffff;
    text-decoration: none;
    border: 0;
    cursor: pointer;
    transition:
      transform var(--transition-base),
      opacity var(--transition-base);
  }

  .share__button:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  .share__icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* Warna brand tiap platform (tema-agnostik, kenal-sekilas) */
  .share__button--whatsapp {
    background-color: #25d366;
  }

  .share__button--facebook {
    background-color: #1877f2;
  }

  .share__button--x {
    background-color: #000000;
  }

  .share__button--telegram {
    background-color: #26a5e4;
  }

  .share__button--linkedin {
    background-color: #0a66c2;
  }

  .share__button--email {
    background-color: var(--color-muted);
  }

  .share__button--copy {
    background-color: var(--color-primary);
  }

  /* Ikon check hanya muncul sesaat setelah URL berhasil disalin */
  .share__icon--check {
    display: none;
  }

  :global(.share__button--copy[data-copied]) .share__icon--clip {
    display: none;
  }

  :global(.share__button--copy[data-copied]) .share__icon--check {
    display: block;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const copyButton = document.querySelector<HTMLButtonElement>('[data-share-copy]');

    copyButton?.addEventListener('click', async () => {
      if (copyButton.dataset.copied) return;
      const targetUrl = copyButton.dataset.url || location.href;
      const copiedLabel = copyButton.dataset.copiedLabel ?? 'Link copied!';

      try {
        await navigator.clipboard.writeText(targetUrl);
        copyButton.dataset.copied = 'true';
        copyButton.setAttribute('aria-label', copiedLabel);
        copyButton.title = copiedLabel;
        window.setTimeout(() => {
          delete copyButton.dataset.copied;
          const originalLabel = copyButton.dataset.label ?? '';
          copyButton.setAttribute('aria-label', originalLabel);
          copyButton.title = originalLabel;
        }, 2000);
      } catch {
        /* clipboard diblokir → biarkan tombol tanpa feedback */
      }
    });
  });
</script>
