---
/**
 * Badge — label kecil berbentuk pill untuk penanda singkat
 * (mis. "24 Jam", "Unggulan", nanti juga tag artikel blog).
 *
 * Murni presentasi: teks datang dari <slot />, warna dari prop variant.
 */
interface Props {
	variant?: 'primary' | 'emergency' | 'neutral';
	class?: string;
}

const { variant = 'primary', class: className } = Astro.props;
---

<span class:list={['badge', `badge--${variant}`, className]}>
	<slot />
</span>

<style>
	.badge {
		display: inline-flex;
		align-items: center;
		padding: 0.25rem 0.75rem;
		border-radius: var(--radius-full);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.badge--primary {
		background-color: var(--color-primary-light);
		color: var(--color-primary-text); /* primary-text: kontras di dua tema */
	}

	.badge--emergency {
		background-color: var(--color-emergency-light);
		color: var(--color-emergency-dark);
	}

	.badge--neutral {
		background-color: var(--color-surface-alt);
		color: var(--color-body);
	}
</style>
