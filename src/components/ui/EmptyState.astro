---
/**
 * EmptyState — komponen UI reusable untuk menampilkan kondisi kosong (data kosong /
 * pencarian tanpa hasil / konten segera hadir) secara konsisten dan semantik.
 *
 * Murni presentasional (Single Source of Truth) sesuai docs/STRUCTURE.md:
 * seluruh teks diteruskan melalui props atau terjemahan i18n pemanggil.
 */
import { Icon } from 'astro-icon/components';
import Button from '@/components/ui/Button.astro';

export type EmptyStateIcon =
  | 'inbox'
  | 'briefcase'
  | 'newspaper'
  | 'file-text'
  | 'book-open'
  | 'image'
  | 'help-circle'
  | 'building'
  | 'message-square'
  | 'activity'
  | 'search';

interface Props {
  /** Judul pesan kondisi kosong */
  title: string;
  /** Deskripsi penjelasan atau panduan tindak lanjut */
  description?: string;
  /** Ikon preset yang merepresentasikan konteks */
  icon?: EmptyStateIcon;
  /** Label teks tombol tindakan opsional */
  actionText?: string;
  /** Tautan tujuan tombol tindakan opsional */
  actionHref?: string;
  /** Varian visual tombol (default: 'outline') */
  actionVariant?: 'primary' | 'emergency' | 'outline' | 'light' | 'ghost';
  /** Ukuran visual komponen: 'sm' | 'md' | 'lg' */
  size?: 'sm' | 'md' | 'lg';
  /** Class tambahan dari pemakai */
  class?: string;
}

const {
  title,
  description,
  icon = 'inbox',
  actionText,
  actionHref,
  actionVariant = 'outline',
  size = 'md',
  class: className,
} = Astro.props;

// Nama ikon Lucide (dataset @iconify-json/lucide), dirender via <Icon> astro-icon.
const LUCIDE_NAMES: Record<EmptyStateIcon, string> = {
  inbox: 'inbox',
  briefcase: 'briefcase',
  newspaper: 'newspaper',
  'file-text': 'file-text',
  'book-open': 'book-open',
  image: 'image',
  'help-circle': 'circle-help',
  building: 'building',
  'message-square': 'message-square',
  activity: 'activity',
  search: 'search',
};

const iconName = LUCIDE_NAMES[icon] ?? LUCIDE_NAMES.inbox;
---

<div class:list={['empty-state', `empty-state--${size}`, className]}>
  <div class="empty-state__icon-wrapper">
    <slot name="icon">
      <Icon name={`lucide:${iconName}`} class="empty-state__icon" aria-hidden="true" />
    </slot>
  </div>

  <h3 class="empty-state__title">{title}</h3>

  {description && <p class="empty-state__description">{description}</p>}

  {
    (actionHref && actionText) || Astro.slots.has('default') ? (
      <div class="empty-state__actions">
        {actionHref && actionText && (
          <Button href={actionHref} variant={actionVariant} size={size === 'lg' ? 'lg' : 'md'}>
            {actionText}
          </Button>
        )}
        <slot />
      </div>
    ) : null
  }
</div>

<style>
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background-color: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-xl, var(--radius-lg));
    margin: 0 auto;
    width: 100%;
  }

  .empty-state--sm {
    padding: var(--space-6) var(--space-4);
    max-width: 28rem;
  }

  .empty-state--md {
    padding: var(--space-12) var(--space-6);
    max-width: 38rem;
  }

  .empty-state--lg {
    padding: var(--space-16) var(--space-8);
    max-width: 48rem;
  }

  .empty-state__icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-primary-light);
    color: var(--color-primary-text);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-4);
    transition: transform var(--transition-base);
  }

  .empty-state--sm .empty-state__icon-wrapper {
    width: 3rem;
    height: 3rem;
  }

  .empty-state--md .empty-state__icon-wrapper {
    width: 4rem;
    height: 4rem;
  }

  .empty-state--lg .empty-state__icon-wrapper {
    width: 5rem;
    height: 5rem;
  }

  .empty-state__icon {
    width: 50%;
    height: 50%;
  }

  .empty-state:hover .empty-state__icon-wrapper {
    transform: scale(1.05);
  }

  .empty-state__title {
    color: var(--color-ink);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-2);
  }

  .empty-state--sm .empty-state__title {
    font-size: var(--text-lg);
  }

  .empty-state--lg .empty-state__title {
    font-size: var(--text-2xl);
  }

  .empty-state__description {
    color: var(--color-muted);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    max-width: 32rem;
    margin: 0;
  }

  .empty-state--sm .empty-state__description {
    font-size: var(--text-sm);
  }

  .empty-state__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>
