---
/**
 * SkeletonCard — versi "sedang memuat" dari PostCard.
 *
 * Konsep: skeleton LAYOUT-MATCHING. Placeholder meniru struktur
 * konten asli (badge → judul → 2 baris isi → meta) supaya saat
 * konten masuk, layout tidak "lompat" (menghindari layout shift).
 * Kalau struktur skeleton beda jauh dari konten asli, efek
 * perceived-performance-nya hilang.
 *
 * Ini juga contoh komposisi: Card + Skeleton (dua primitive ui/)
 * digabung jadi komponen yang lebih spesifik.
 */
import Card from '@/components/ui/Card.astro';
import Skeleton from '@/components/ui/Skeleton.astro';
---

<Card class="skeleton-card" aria-hidden="true">
  <Skeleton width="5rem" height="1.3rem" />
  <Skeleton width="85%" height="1.5rem" />
  <div class="skeleton-card__lines">
    <Skeleton height="0.875rem" />
    <Skeleton height="0.875rem" />
    <Skeleton width="60%" height="0.875rem" />
  </div>
  <div class="skeleton-card__meta">
    <Skeleton width="9rem" height="0.75rem" />
  </div>
</Card>

<style>
  :global(.skeleton-card) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .skeleton-card__lines {
    display: grid;
    gap: var(--space-2);
  }

  .skeleton-card__meta {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-3);
  }
</style>
