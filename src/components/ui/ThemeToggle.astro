---
/**
 * ThemeToggle - tombol ganti tema gelap/terang.
 *
 * ARSITEKTUR TEMA:
 *  - Tema = atribut [data-theme='light'|'dark'] di <html>.
 *  - Nilainya dipasang script inline di BaseLayout SEBELUM paint
 *    pertama (baca localStorage) -> tidak ada kedipan putih (FOUC).
 *  - Tombol ini hanya MENGGANTI nilai + menyimpan pilihan
 *    (localStorage key: 'themechoice').
 *  - Semua warna mengikuti token di tokens.css.
 *
 * I18N: label dari kamus ui.ts lewat prop `lang` - komponen ui/
 * tidak membaca URL sendiri, halaman/layout yang menentukan locale.
 *
 * IKON: matahari (tema terang) / bulan (tema gelap). Perpindahan
 * ikon murni CSS via [data-theme] - JS tidak perlu mengganti ikon.
 *
 * TRANSISI SIRKULAR: klik memicu document.startViewTransition();
 * snapshot tema lama baru dianimasikan clip-path circle dari titik
 * klik (View Transition API). CSS-nya di blok <style is:global>.
 */
import { tFactory, type Lang } from '@/i18n';

interface Props {
  /** Locale halaman - menentukan bahasa label aksesibilitas */
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const t = tFactory(lang);
---

<button
  type="button"
  class:list={['theme-toggle', className]}
  data-theme-toggle
  aria-label={t('theme.toggle')}
  title={t('theme.toggle')}
>
  <svg
    class="theme-toggle__icon theme-toggle__icon--sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
    ></path>
  </svg>
  <svg
    class="theme-toggle__icon theme-toggle__icon--moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    color: var(--color-body);
    background-color: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition:
      color var(--transition-base),
      border-color var(--transition-base),
      background-color var(--transition-base);
  }

  .theme-toggle:hover {
    color: var(--color-primary-text);
    border-color: var(--color-primary-text);
    background-color: var(--color-primary-light);
  }

  .theme-toggle__icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  /* Ikon mengikuti tema aktif - tanpa JS */
  .theme-toggle__icon--moon {
    display: none;
  }

  :global([data-theme='dark']) .theme-toggle__icon--moon {
    display: block;
  }

  :global([data-theme='dark']) .theme-toggle__icon--sun {
    display: none;
  }
</style>
<style is:global>
  /* == Transisi sirkular ganti tema (View Transition API) ==
     Blok ini HANYA aktif saat class vt-theme-circle-reveal terpasang di
     <html> (dipasang JS tepat sebelum animasi, dilepas setelah selesai),
     jadi cross-fade bawaan ClientRouter untuk navigasi antar halaman
     tidak terpengaruh. Pseudo-elemen ::view-transition-* tidak bisa
     di-scope per-komponen karena bukan bagian DOM komponen.

     Layer lama/new sama-sama di-nonanimasikan; layer BARU (tema tujuan)
     selalu dianimasikan clip-path circle lewat Web Animations API dari
     script di bawah — lingkaran tema tujuan mengembang dari titik klik,
     untuk kedua arah (terang→gelap maupun gelap→terang).
  */
  html.vt-theme-circle-reveal ::view-transition-old(root),
  html.vt-theme-circle-reveal ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  /* Snapshot layer new difoto tepat setelah callback selesai - sebelum
     .ready resolve. Transisi warna CSS (global.css) harus sudah OFF di
     momen itu, kalau tidak snapshot new memotret frame pertama transisi
     (= tampilan tema lama) dan lingkaran reveal tidak terlihat. */
  html.vt-theme-no-anim,
  html.vt-theme-no-anim *,
  html.vt-theme-no-anim *::before,
  html.vt-theme-no-anim *::after {
    transition: none !important;
  }

  html.vt-theme-circle-reveal ::view-transition-old(root) {
    z-index: 1;
  }

  html.vt-theme-circle-reveal ::view-transition-new(root) {
    z-index: 9999;
  }
</style>

<script>
  import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';

  // Module script = deferred -> DOM sudah siap saat dijalankan.
  // Klik ditangani lewat DELEGASI di document (bukan binding per-tombol)
  // supaya listener bertahan melewati navigasi ClientRouter: runScripts
  // tidak menjalankan ulang bundle script yang sudah pernah dieksekusi
  // (dedup), jadi binding per-tombol akan mati di halaman berikutnya.
  // Flag di window mencegah listener ganda saat router menjalankan ulang
  // bundle ini (state module tidak bertahan antar-eksekusi).
  // astro:before-swap (TransitionBeforeSwapEvent - tipe resmi modul
  // astro:transitions/client) menyalin tema ke dokumen baru SEBELUM swap:
  // swapRootAttributes menghapus atribut runtime <html> (termasuk
  // data-theme), dan tanpa salinan ini snapshot halaman gelap bisa tampak
  // terang sesaat selama cross-fade.
  interface ThemeWindow {
    __themeControllerBound?: boolean;
  }

  const themeWindow = window as unknown as ThemeWindow;

  function applyTheme(theme: 'light' | 'dark') {
    document.documentElement.dataset.theme = theme;
    try {
      localStorage.setItem('themechoice', theme);
    } catch {
      /* localStorage bisa gagal (mode privat) - tema tetap berganti utk sesi ini */
    }
  }

  function currentTheme(): 'light' | 'dark' {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  const TRANSITION_DURATION = 500;
  // Token anti-balapan: klik ganda yang sangat cepat memulai transisi
  // baru sebelum cleanup transisi lama; token lama tak boleh melepas
  // class milik transisi yang masih berjalan.
  let revealSeq = 0;

  function cleanupRevealClass(token: number) {
    if (token !== revealSeq) return;
    document.documentElement.classList.remove('vt-theme-circle-reveal');
  }

  function animateThemeReveal(x: number, y: number) {
    // Fallback browser tanpa View Transition API: ganti tema langsung.
    if (typeof document.startViewTransition !== 'function') {
      applyTheme(currentTheme() === 'dark' ? 'light' : 'dark');
      return;
    }

    // Radius = jarak ke pojok viewport terjauh, agar lingkaran menutup
    // seluruh layar di ujung animasi.
    const radius = Math.hypot(
      Math.max(x, window.innerWidth - x),
      Math.max(y, window.innerHeight - y)
    );
    const token = ++revealSeq;
    const root = document.documentElement;

    document
      .startViewTransition(() => {
        // Class dipasang DI CALLBACK (sebelum snapshot): transisi warna
        // dimatikan + animasi sudah aktif saat pseudo-element lahir.
        root.classList.add('vt-theme-no-anim', 'vt-theme-circle-reveal');
        applyTheme(currentTheme() === 'dark' ? 'light' : 'dark');
      })
      .ready.then(() => {
        root
          .animate(
            {
              clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`],
            },
            {
              duration: TRANSITION_DURATION,
              easing: 'ease-in-out',
              pseudoElement: '::view-transition-new(root)',
            }
          )
          .finished.finally(() => {
            root.classList.remove('vt-theme-no-anim');
            cleanupRevealClass(token);
          });
      })
      .catch(() => {
        // Animasi gagal/dibatalkan (mis. tab hidden) - pastikan wajib pulih.
        root.classList.remove('vt-theme-no-anim');
        cleanupRevealClass(token);
      });
  }

  if (!themeWindow.__themeControllerBound) {
    themeWindow.__themeControllerBound = true;

    document.addEventListener('click', (event) => {
      const toggle =
        event.target instanceof Element ? event.target.closest('[data-theme-toggle]') : null;
      if (!toggle) return;
      // Klik via keyboard datang dengan koordinat 0,0 - geser pusat
      // lingkaran ke tengah tombol supaya reveal tetap terlihat wajar.
      let x = event.clientX;
      let y = event.clientY;
      if (x === 0 && y === 0) {
        const rect = toggle.getBoundingClientRect();
        x = rect.left + rect.width / 2;
        y = rect.top + rect.height / 2;
      }
      animateThemeReveal(x, y);
    });

    document.addEventListener('astro:before-swap', (event: Event) => {
      (event as TransitionBeforeSwapEvent).newDocument.documentElement.dataset.theme =
        currentTheme();
    });
  }
</script>
