---
/**
 * Skeleton — primitive loading placeholder dengan efek shimmer.
 *
 * Kapan dipakai: saat konten dimuat secara ASINKRON dari sisi browser
 * (fetch API, filter/search, submit form) — BUKAN untuk halaman static
 * yang sudah ter-render saat build. Menampilkan skeleton di konten yang
 * sebenarnya sudah ada justru menurunkan perceived performance.
 *
 * Kenapa skeleton, bukan spinner? Spinner bilang "tunggu, tidak tahu
 * lamanya"; skeleton bilang "konten SEPERTI INI yang akan muncul" —
 * user merasa lebih cepat karena membayangkan bentuknya (research UX:
 * perceived performance).
 *
 * A11y:
 *  - aria-hidden: murni dekoratif, screen reader tak perlu tahu.
 *  - prefers-reduced-motion: shimmer dimatikan untuk user yang sensitif
 *    terhadap gerakan (aturan WCAG 2.3.3).
 *
 * Shimmer pakai animasi `transform` (bukan background-position) karena
 * transform dianimasikan di compositor GPU — tidak memicu repaint.
 */
interface Props {
	/** Lebar elemen, nilai CSS apa pun: '60%', '12rem', dst. */
	width?: string;
	/** Tinggi elemen, mis. '1rem' (1 baris teks) atau '8rem' (gambar). */
	height?: string;
	/** Bentuk lingkaran (avatar) */
	circle?: boolean;
	class?: string;
}

const { width = '100%', height = '1rem', circle = false, class: className } = Astro.props;
---

<span
	class:list={['skeleton', { 'skeleton--circle': circle }, className]}
	style={`width:${width};height:${height}`}
	aria-hidden="true"
>
	<span class="skeleton__shimmer"></span>
</span>

<style>
	.skeleton {
		position: relative;
		display: block;
		overflow: hidden;
		background-color: var(--color-surface-alt);
		border-radius: var(--radius-md);
	}

	.skeleton--circle {
		border-radius: var(--radius-full);
	}

	/* Sweep terang yang melintas sekali tiap siklus */
	.skeleton__shimmer {
		position: absolute;
		inset: 0;
		transform: translateX(-100%);
		background: linear-gradient(
			90deg,
			transparent 0%,
			rgb(255 255 255 / 0.65) 50%,
			transparent 100%
		);
		animation: skeleton-shimmer 1.4s ease-in-out infinite;
	}

	@keyframes skeleton-shimmer {
		to {
			transform: translateX(100%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.skeleton__shimmer {
			animation: none;
		}
	}
</style>
