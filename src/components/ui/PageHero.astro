---
/**
 * PageHero — kepala halaman untuk halaman dalam (about/services/contact).
 * Dibuat komponen karena dipakai 3+ halaman — aturan "dipakai 2+ kali → ui/".
 *
 * Murni presentasi: teks sudah diterjemahkan oleh halaman pemanggil
 * (halaman punya `t()`), komponen ini tidak tahu soal locale.
 */
interface Props {
	/** Label kecil di atas judul */
	eyebrow?: string;
	title: string;
	lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="page-hero">
	<div class="container">
		{eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
		<h1 class="page-hero__title">{title}</h1>
		{lead && <p class="page-hero__lead">{lead}</p>}
	</div>
</section>

<style>
	.page-hero {
		background: linear-gradient(180deg, var(--color-primary-light) 0%, var(--color-surface) 100%);
		padding-block: var(--space-12);
		text-align: center;
	}

	.page-hero__eyebrow {
		color: var(--color-primary-text);
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.page-hero__title {
		font-size: var(--text-4xl);
		margin-top: var(--space-2);
	}

	.page-hero__lead {
		color: var(--color-muted);
		font-size: var(--text-lg);
		max-width: 40rem;
		margin-inline: auto;
		margin-top: var(--space-3);
	}
</style>
