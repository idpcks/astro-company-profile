---
/**
 * CTASection — band penutup dengan ajakan utama (hubungi kami).
 * I18N: teks dari kamus; tombol light/ghost untuk background gelap.
 */
import Button from '@/components/ui/Button.astro';
import { localePath, tFactory, type Lang } from '@/i18n';
import { SITE } from '@/data/site';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = tFactory(lang);

const phoneTel = SITE.phone.replace(/\s/g, '');
---

<section class="section">
	<div class="container">
		<div class="cta">
			<h2 class="cta__title">{t('cta.title')}</h2>
			<p class="cta__lead">{t('cta.lead')}</p>
			<div class="cta__actions">
				<Button href={localePath('/contact', lang)} variant="light" size="lg">
					{t('cta.contact')}
				</Button>
				<Button href={`tel:${phoneTel}`} variant="ghost" size="lg">
					{t('cta.phone')} {SITE.phone}
				</Button>
			</div>
		</div>
	</div>
</section>

<style>
	/* Gradient primary-dark→primary dipakai di dua tema — teks di
	   atasnya selalu putih, jadi tidak butuh token tema. */
	.cta {
		padding: var(--space-12) var(--space-8);
		border-radius: var(--radius-lg);
		background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
		text-align: center;
	}

	.cta__title {
		color: #ffffff;
		font-size: var(--text-3xl);
	}

	.cta__lead {
		color: rgb(255 255 255 / 0.85);
		max-width: 36rem;
		margin-inline: auto;
		margin-top: var(--space-3);
	}

	.cta__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}

	@media (max-width: 640px) {
		.cta {
			padding: var(--space-8) var(--space-4);
		}
	}
</style>
