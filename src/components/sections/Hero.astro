---
/**
 * Hero — section pembuka landing page.
 * I18N: menerima `lang`; teks default dari kamus, bisa dioverride
 * lewat props (halaman kampanye, dsb). Strip darurat = khas RS.
 */
import Button from '@/components/ui/Button.astro';
import { localePath, tFactory, type Lang } from '@/i18n';
import { SITE } from '@/data/site';

interface Props {
	lang: Lang;
	eyebrow?: string;
	title?: string;
	lead?: string;
}

const { lang, eyebrow, title, lead } = Astro.props;
const t = tFactory(lang);

// Item trust — konten spesifik section ini, dipakai sekali → boleh di sini.
const trustItems = [t('hero.trust.doctors'), t('hero.trust.facilities'), t('hero.trust.service')];

const emergencyTel = SITE.emergencyPhone.replace(/\s/g, '');
---

<section class="hero">
	<div class="container">
		<p class="hero__eyebrow">{eyebrow ?? t('hero.eyebrow')}</p>
		<h1 class="hero__title">{title ?? t('hero.title')}</h1>
		<p class="hero__lead">{lead ?? SITE.description[lang]}</p>

		<div class="hero__actions">
			<Button href={localePath('/services', lang)} size="lg">
				{t('hero.cta.services')}
			</Button>
			<Button href={localePath('/contact', lang)} variant="outline" size="lg">
				{t('hero.cta.contact')}
			</Button>
		</div>

		<ul class="hero__trust" role="list">
			{
				trustItems.map((item) => (
					<li>
						<svg
							class="hero__check"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M20 6 9 17l-5-5" />
						</svg>
						{item}
					</li>
				))
			}
		</ul>
		
	</div>
</section>

<style>
	.hero {
		background: linear-gradient(180deg, var(--color-primary-light) 0%, var(--color-surface) 100%);
		padding-block: var(--space-16) var(--space-12);
		text-align: center;
	}

	.hero__eyebrow {
		color: var(--color-primary-text);
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.hero__title {
		font-size: var(--text-5xl);
		max-width: 44rem;
		margin-inline: auto;
		margin-top: var(--space-3);
	}

	.hero__lead {
		color: var(--color-muted);
		font-size: var(--text-lg);
		max-width: 40rem;
		margin-inline: auto;
		margin-top: var(--space-4);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}

	.hero__trust {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-3) var(--space-6);
		list-style: none;
		margin: var(--space-6) 0 0;
		padding: 0;
		color: var(--color-body);
		font-size: var(--text-sm);
	}

	.hero__trust li {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
	}

	.hero__check {
		width: 1rem;
		height: 1rem;
		color: var(--color-primary-text);
	}

	/* Strip darurat: kartu merah tipis di bawah hero */
	.hero__emergency {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		margin-top: var(--space-12);
		padding: var(--space-4) var(--space-6);
		background-color: var(--color-emergency-light);
		border: 1px solid var(--color-emergency);
		border-radius: var(--radius-lg);
		text-align: start;
	}

	.hero__emergency-title {
		color: var(--color-emergency-text);
		font-weight: 700;
	}

	.hero__emergency p {
		font-size: var(--text-sm);
	}

	@media (max-width: 640px) {
		.hero__title {
			font-size: var(--text-4xl);
		}

		.hero__emergency {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
