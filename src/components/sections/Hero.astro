---
/**
 * Hero — section pembuka landing page.
 * I18N: menerima `lang`; teks default dari kamus, bisa dioverride
 * lewat props (halaman kampanye, dsb). Strip darurat = khas RS.
 */
import Button from '@/components/ui/Button.astro';
import SiteImage from '@/components/ui/SiteImage.astro';
import { localePath, tFactory, type Lang } from '@/i18n';
import { SITE } from '@/data/site';
import imgCompanyBuilding from '@/assets/images/img_companybuilding.webp';

interface Props {
	lang: Lang;
	eyebrow?: string;
	title?: string;
	lead?: string;
}

const { lang, eyebrow, title, lead } = Astro.props;
const t = tFactory(lang);

// Item trust — konten spesifik section ini, dipakai sekali → boleh di sini.
const trustItems = [t('hero.trust.doctors'), t('hero.trust.facilities'), t('hero.trust.service')];

const emergencyTel = SITE.emergencyPhone.replace(/\s/g, '');
---

<section class="hero">
	<div class="hero__bg" aria-hidden="true">
		<SiteImage
			src={imgCompanyBuilding}
			alt=""
			loading="eager"
			fetchpriority="high"
			width={1200}
			height={900}
		/>
	</div>
	<div class="hero__overlay" aria-hidden="true"></div>

	<div class="container hero__content">
		<p class="hero__eyebrow">{eyebrow ?? t('hero.eyebrow')}</p>
		<h1 class="hero__title">{title ?? t('hero.title')}</h1>
		<p class="hero__lead">{lead ?? SITE.description[lang]}</p>

		<div class="hero__actions">
			<Button href={localePath('/services', lang)} size="lg">
				{t('hero.cta.services')}
			</Button>
			<Button href={localePath('/contact', lang)} variant="ghost" size="lg">
				{t('hero.cta.contact')}
			</Button>
		</div>

		<ul class="hero__trust" role="list">
			{
				trustItems.map((item) => (
					<li>
						<svg
							class="hero__check"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M20 6 9 17l-5-5" />
						</svg>
						{item}
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding-block: clamp(5.5rem, 12vw, 9rem) var(--space-12);
	}

	.hero__bg {
		position: absolute;
		inset: 0;
	}

	.hero__bg :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Veil gelap: jamin kontras teks di atas foto (WCAG), kiri lebih pekat
	   supaya blok teks tetap terbaca saat teks lebar di layar besar. */
	.hero__overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			75deg,
			rgb(15 23 42 / 0.85) 0%,
			rgb(15 23 42 / 0.6) 50%,
			rgb(15 23 42 / 0.3) 100%
		);
	}

	.hero__content {
		position: relative;
		z-index: 1;
		max-width: 44rem;
	}

	.hero__eyebrow {
		color: #5eead4; /* teal-300 — kontras di atas gelap */
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		margin: 0;
	}

	.hero__title {
		color: #ffffff;
		font-size: var(--text-5xl);
		max-width: 40rem;
		margin-top: var(--space-3);
	}

	.hero__lead {
		color: rgb(226 232 240 / 0.95); /* slate-200 */
		font-size: var(--text-lg);
		max-width: 40rem;
		margin-top: var(--space-4);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}

	.hero__trust {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3) var(--space-6);
		list-style: none;
		margin: var(--space-6) 0 0;
		padding: 0;
		color: rgb(226 232 240 / 0.95);
		font-size: var(--text-sm);
	}

	.hero__trust li {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
	}

	.hero__check {
		width: 1rem;
		height: 1rem;
		color: #5eead4;
	}

	/* Strip darurat: kartu merah tipis di bawah hero */
	.hero__emergency {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		margin-top: var(--space-12);
		padding: var(--space-4) var(--space-6);
		background-color: var(--color-emergency-light);
		border: 1px solid var(--color-emergency);
		border-radius: var(--radius-lg);
		text-align: start;
	}

	.hero__emergency-title {
		color: var(--color-emergency-text);
		font-weight: 700;
	}

	.hero__emergency p {
		font-size: var(--text-sm);
	}

	@media (max-width: 768px) {
		.hero__overlay {
			background: linear-gradient(
				180deg,
				rgb(15 23 42 / 0.8) 0%,
				rgb(15 23 42 / 0.55) 100%
			);
		}
	}

	@media (max-width: 640px) {
		.hero__title {
			font-size: var(--text-4xl);
		}

		.hero__emergency {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
