---

<PageHero
  eyebrow={t('pagehero.eyebrow.galeri')}
  title={t('galeriPage.hero.title')}
  lead={t('galeriPage.hero.lead')}
/>

<section class="section">
  <div class="container">
    <SectionHeading title={t('galeriPage.note.title')} align="start" />
    <div class="galeri__grid" data-pswp-gallery>
      {
        GALLERY.map((item, i) => (
          <figure class="galeri__item">
            <a
              class="galeri__link"
              href={item.image?.src}
              data-pswp-width={item.image?.width}
              data-pswp-height={item.image?.height}
              data-caption={item.caption[lang]}
            >
              <SiteImage
                src={item.thumbnail}
                alt={item.caption[lang]}
                width={800}
                height={600}
                loading={i === 0 ? 'eager' : 'lazy'}
                class="galeri__image"
              />
            </a>
            {i === 0 && <figcaption class="galeri__caption">{item.caption[lang]}</figcaption>}
          </figure>
        ))
      }
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <SectionHeading title={t('galeriPage.video.title')} align="start" />
    <div class="galeri__videos" data-pswp-gallery>
      {
        VIDEOS.map((item) => (
          <a
            class="galeri__video"
            href={item.video?.poster ?? item.video?.src}
            data-pswp-type="video"
            data-pswp-video-src={item.video?.src}
            data-poster={item.video?.poster}
            data-pswp-width={item.video?.width}
            data-pswp-height={item.video?.height}
            data-caption={item.caption[lang]}
            title={item.caption[lang]}
          >
            <SiteImage
              src={item.thumbnail}
              alt={item.caption[lang]}
              width={480}
              height={270}
              loading="lazy"
              class="galeri__video-image"
            />
            <span class="galeri__video-play" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M8 5.5v13a.6.6 0 0 0 .92.51l10.2-6.5a.6.6 0 0 0 0-1.02L8.92 5A.6.6 0 0 0 8 5.5Z" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<CTASection lang={lang} />

<style>
  /*
   * Pola L terbalik: foto utama di kiri-atas (2x2), thumbnail mengisi
   * kolom kanan (t1, t2) dan baris bawah (t3, t4, t5).
   */
  .galeri__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .galeri__item {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  /* ≥ 40rem: pola L terbalik — foto utama (2x2) + thumbnail kolom kanan
     dan baris bawah. Di layar sempit grid jatuh ke satu kolom. */
  @media (min-width: 40rem) {
    .galeri__grid {
      grid-template-columns: repeat(3, 1fr);
      grid-template-areas:
        'hero hero t1'
        'hero hero t2'
        't3   t4   t5';
      gap: var(--space-6);
    }

    .galeri__item:nth-child(1) {
      grid-area: hero;
      aspect-ratio: auto;
    }
    .galeri__item:nth-child(2) {
      grid-area: t1;
    }
    .galeri__item:nth-child(3) {
      grid-area: t2;
    }
    .galeri__item:nth-child(4) {
      grid-area: t3;
    }
    .galeri__item:nth-child(5) {
      grid-area: t4;
    }
    .galeri__item:nth-child(6) {
      grid-area: t5;
    }
  }

  .galeri__link {
    position: absolute;
    inset: 0;
    display: block;
    cursor: zoom-in;
  }

  .galeri__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .galeri__caption {
    position: absolute;
    left: var(--space-2);
    bottom: var(--space-2);
    max-width: calc(100% - var(--space-2) * 2);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-md);
    background: rgb(0 0 0 / 0.7);
    color: #fff;
    font-size: var(--text-sm);
    pointer-events: none;
  }

  .galeri__videos {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .galeri__video {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    cursor: pointer;
  }

  .galeri__video-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .galeri__video-play {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: 3.25rem;
    height: 3.25rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.45);
    color: #fff;
    transition:
      transform 400ms cubic-bezier(0.32, 0.72, 0, 1),
      background-color 400ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .galeri__video-play svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .galeri__video:hover .galeri__video-play {
    transform: scale(1.08);
    background-color: rgb(0 0 0 / 0.6);
  }

  @media (min-width: 40rem) {
    .galeri__videos {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }

  @media (min-width: 64rem) {
    .galeri__videos {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

<!-- Caption lightbox dirender PhotoSwipe di luar komponen ini, jadi butuh style global. -->
<style is:global>
  .pswp__galeri-caption {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    max-width: min(90vw, 32rem);
    padding: 0.375rem 0.875rem;
    border-radius: 0.5rem;
    background: rgb(0 0 0 / 0.75);
    color: #fff;
    font-size: 0.9375rem;
    text-align: center;
    pointer-events: none;
  }
  .pswp__galeri-caption:empty {
    display: none;
  }

  /* Slide video: isi video mengikuti boks content PhotoSwipe. */
  .pswp__content video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
  }
</style>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  let lightbox: PhotoSwipeLightbox | null = null;

  document.addEventListener('astro:page-load', () => {
    // Bersihkan instance sebelumnya jika ada (navigasi SPA kembali ke halaman ini)
    if (lightbox) {
      lightbox.destroy();
      lightbox = null;
    }

    lightbox = new PhotoSwipeLightbox({
      gallery: '[data-pswp-gallery]',
      children: 'a',
      pswpModule: () => import('photoswipe'),
      bgOpacity: 0.92,
    });

    // PhotoSwipe 5.4 tidak membaca data-pswp-video-src secara bawaan; slide
    // video disajikan lewat filter: ubah anchor tipe video jadi konten HTML
    // berisi <video>. autoplay muted agar langsung tampak berputar (browser
    // memblokir autoplay bersuara), user bisa unmute via kontrol.
    lightbox.addFilter('domItemData', (itemData, _element, linkEl) => {
      if (linkEl?.dataset.pswpType === 'video' && linkEl.dataset.pswpVideoSrc) {
        const src = linkEl.dataset.pswpVideoSrc;
        const poster = linkEl.dataset.poster ?? '';
        itemData.type = 'video';
        itemData.html =
          '<video controls playsinline autoplay muted preload="metadata"' +
          (poster ? ` poster="${poster}"` : '') +
          ` src="${src}"></video>`;
      }
      return itemData;
    });

    // Tampilkan caption foto aktif di bagian bawah lightbox.
    lightbox.on('uiRegister', () => {
      lightbox!.pswp?.ui?.registerElement({
        name: 'galeri-caption',
        order: 9,
        isButton: false,
        appendTo: 'root',
        html: '',
        onInit: (el, pswp) => {
          el.classList.add('pswp__galeri-caption');
          pswp.on('change', () => {
            const link = pswp.currSlide?.data.element as HTMLAnchorElement | undefined;
            el.textContent = link?.dataset.caption ?? '';
          });
        },
      });
    });

    lightbox.init();
  });
</script>
