---
/**
 * Isi halaman /galeri — dipakai bersama oleh root (id) & [lang] (en).
 * Grid foto dummy (Picsum) untuk melihat tata letak galeri — DIGANTI
 * foto asli saat materi tersedia. Caption per-locale ditulis di sini
 * (pola sama dengan AboutContent), bukan di data/.
 *
 * Tata letak foto: 1 foto utama (2x2) + 5 thumbnail yang membentuk huruf L
 * terbalik (kolom kanan + baris bawah). Dirancang untuk tepat 6 foto.
 * Klik foto mana pun membuka lightbox PhotoSwipe.
 *
 * Video: daftar dummy PADA kunci ― tampil sebagai list terpisah di bawah
 * grid foto; klik item membuka slide video di lightbox PhotoSwipe yang sama
 * (pola data-pswp-video-src). Ganti src poster/video dengan materi asli nanti.
 */
import CTASection from '@/components/sections/CTASection.astro';
import PageHero from '@/components/ui/PageHero.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import SiteImage from '@/components/ui/SiteImage.astro';
import { tFactory, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = tFactory(lang);

interface GalleryItem {
  /** Jenis media galeri. */
  type: 'image' | 'video';

  /** Gambar thumbnail yang tampil di grid. */
  thumbnail: string;

  image?: {
    /** URL gambar resolusi penuh. */
    src: string;
    /** Dimensi asli gambar untuk PhotoSwipe. */
    width: number;
    height: number;
  };

  video?: {
    /** URL video. */
    src: string;
    /** Poster yang ditampilkan sebelum video diputar. */
    poster?: string;
    /** Dimensi asli video untuk PhotoSwipe. */
    width: number;
    height: number;
  };

  /** Caption per locale. */
  caption: {
    id: string;
    en: string;
  };
}

