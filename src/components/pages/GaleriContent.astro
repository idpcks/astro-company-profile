---
/**
 * Isi halaman /galeri — dipakai bersama oleh root (id) & [lang] (en).
 * Minimal: hero + catatan bahwa galeri foto sedang disiapkan.
 */
import CTASection from '@/components/sections/CTASection.astro';
import Card from '@/components/ui/Card.astro';
import PageHero from '@/components/ui/PageHero.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { tFactory, type Lang } from '@/i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = tFactory(lang);
---

<PageHero
	eyebrow={t('pagehero.eyebrow.galeri')}
	title={t('galeriPage.hero.title')}
	lead={t('galeriPage.hero.lead')}
/>

<section class="section">
	<div class="container">
		<SectionHeading title={t('galeriPage.note.title')} align="start" />
		<div class="galeri__grid">
			<Card>
				<p class="galeri__note">{t('galeriPage.note.body')}</p>
			</Card>
		</div>
	</div>
</section>

<CTASection lang={lang} />

<style>
	.galeri__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: var(--space-6);
	}

	.galeri__note {
		color: var(--color-muted);
		font-size: var(--text-base);
	}
</style>