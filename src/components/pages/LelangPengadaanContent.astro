---
/**
 * Isi halaman /lelang-pengadaan — dipakai bersama oleh root (id) & [lang] (en).
 * Minimal: hero + catatan bahwa pengumuman lelang segera hadir.
 */
import CTASection from '@/components/sections/CTASection.astro';
import Card from '@/components/ui/Card.astro';
import PageHero from '@/components/ui/PageHero.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { tFactory, type Lang } from '@/i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = tFactory(lang);
---

<PageHero
	eyebrow={t('pagehero.eyebrow.lelangPengadaan')}
	title={t('page.title.lelangPengadaan')}
	lead={t('page.description.lelangPengadaan')}
/>

<section class="section">
	<div class="container">
		<SectionHeading title={t('lelangPengadaanPage.note.title')} align="start" />
		<div class="lelang__grid">
			<Card>
				<p class="lelang__note">{t('lelangPengadaanPage.note.body')}</p>
			</Card>
		</div>
	</div>
</section>

<CTASection lang={lang} />

<style>
	.lelang__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: var(--space-6);
	}

	.lelang__note {
		color: var(--color-muted);
		font-size: var(--text-base);
	}
</style>