---
/**
 * Isi halaman /lelang-pengadaan — dipakai bersama oleh root (id) & [lang] (en).
 */
import CTASection from '@/components/sections/CTASection.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { localePath, tFactory, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = tFactory(lang);
---

<PageHero
  eyebrow={t('pagehero.eyebrow.lelangPengadaan')}
  title={t('page.title.lelangPengadaan')}
  lead={t('page.description.lelangPengadaan')}
/>

<section class="section">
  <div class="container">
    <EmptyState
      icon="file-text"
      title={t('lelangPengadaan.empty.title')}
      description={t('lelangPengadaan.empty.description')}
      actionText={t('lelangPengadaan.empty.action')}
      actionHref={localePath('/contact', lang)}
    />
  </div>
</section>

<CTASection lang={lang} />
