---
/**
 * Konten halaman FAQ — dipakai bersama oleh root (id) & [lang] (en).
 * FAQ schema JSON-LD disuntikkan melalui BaseLayout.
 */
import { localized, tFactory, type Lang } from '@/i18n';
import { FAQ_ITEMS } from '@/data/faq';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = tFactory(lang);

// SOT di src/data/faq.ts — teks yang dirender IDENTIK dengan JSON-LD
// FAQPage di halaman (syarat kebijakan structured data Google).
const faqItems = FAQ_ITEMS.map((item) => ({
	question: localized(item.question, lang),
	answer: localized(item.answer, lang),
}));
---

<section class="section">
  <div class="container faq">
    <h1 class="faq__title">{t('page.title.faq')}</h1>

    <div class="faq__list">
      {
        faqItems.map((item) => (
          <div class="faq-item">
            <h3 class="faq-item__question">{item.question}</h3>
            <p class="faq-item__answer">{item.answer}</p>
          </div>
        ))
      }
    </div>

		<p class="faq__note">
			{lang === 'en'
				? 'If you have a question not listed above, please contact us at '
				: 'Jika Anda memiliki pertanyaan yang tidak tercantum di atas, silakan hubungi kami di '}
			<a href="mailto:info@krakataumedika.co.id">info@krakataumedika.co.id</a>.
		</p>
	</div>
</section>

<style>
  .faq {
    max-width: 48rem;
    margin: 0 auto;
  }

  .faq__title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-6);
  }

  .faq__list {
    display: grid;
    gap: var(--space-4);
  }

  .faq-item {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .faq-item__question {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: var(--space-2);
  }

  .faq-item__answer {
    color: var(--color-body);
    line-height: var(--leading-normal);
  }

  .faq__note {
    margin-top: var(--space-8);
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-align: center;
  }

  .faq__note a {
    color: var(--color-primary-text);
    text-decoration: underline;
  }
</style>
