---
/**
 * Konten halaman Syarat & Ketentuan — dipakai bersama oleh root (id) & [lang] (en).
 */
import { tFactory, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = tFactory(lang);

// Konten per locale — struktur sama agar template tunggal bisa merender keduanya.
const content = {
	id: {
		sections: [
			{
				number: '1',
				title: 'Penerimaan Syarat dan Ketentuan',
				body: 'Dengan mengakses dan menggunakan website RS Krakatau Medika, Anda setuju untuk mematuhi semua syarat dan ketentuan yang tercantum dalam kebijakan ini.',
			},
			{
				number: '2',
				title: 'Perubahan Syarat dan Ketentuan',
				body: 'RS Krakatau Medika berhak mengubah atau memperbarui syarat dan ketentuan ini dari waktu ke waktu tanpa pemberitahuan sebelumnya. Perubahan akan berlaku segera setelah dipublikasikan di situs web.',
			},
			{
				number: '3',
				title: 'Penggunaan Website',
				body: 'Website ini disediakan untuk tujuan informasi layanan kesehatan RS Krakatau Medika. Pengguna dilarang:',
				items: [
					'Menggunakan website untuk tujuan ilegal atau tidak sah',
					'Mengganggu atau merusak keamanan website',
					'Menyalin, mendistribusikan, atau memodifikasi konten tanpa izin tertulis',
					'Menggunakan website untuk menyebarkan virus atau malware',
				],
			},
			{
				number: '4',
				title: 'Hak Kekayaan Intelektual',
				body: 'Semua konten di website ini, termasuk teks, gambar, logo, dan merek dagang, adalah milik RS Krakatau Medika atau lisensornya dan dilindungi oleh undang-undang hak kekayaan intelektual yang berlaku.',
			},
			{
				number: '5',
				title: 'Penyangkalan Tanggung Jawab',
				body: 'RS Krakatau Medika tidak menjamin bahwa website ini bebas dari kesalahan atau gangguan teknis. Informasi yang disediakan bersifat umum dan tidak menggantikan konsultasi medis langsung dengan tenaga kesehatan profesional.',
			},
			{
				number: '6',
				title: 'Keterhubungan Pihak Ketiga',
				body: 'Website ini mungkin berisi tautan ke website pihak ketiga. RS Krakatau Medika tidak bertanggung jawab atas isi, kebijakan privasi, atau praktik website pihak ketiga tersebut.',
			},
			{
				number: '7',
				title: 'Pembatasan Tanggung Jawab',
				body: 'Dalam batas yang diizinkan oleh hukum, RS Krakatau Medika tidak akan bertanggung jawab atas kerusakan tidak langsung, insidental, khusus, konsekuensial, atau punitive yang timbul dari penggunaan atau ketidakmampuan untuk menggunakan website ini.',
			},
			{
				number: '8',
				title: 'Hukum yang Berlaku',
				body: 'Syarat dan ketentuan ini tunduk pada hukum Indonesia. Setiap sengketa yang timbul terkait dengan syarat dan ketentuan ini akan diselesaikan melalui pengadilan yang berwenang di wilayah hukum RS Krakatau Medika.',
			},
			{
				number: '9',
				title: 'Hubungi Kami',
				body: 'Untuk pertanyaan lebih lanjut mengenai syarat dan ketentuan ini, silakan hubungi kami di {email}.',
				email: 'info@krakataumedika.co.id',
			},
		],
	},
	en: {
		sections: [
			{
				number: '1',
				title: 'Acceptance of Terms',
				body: 'By accessing and using the RS Krakatau Medika website, you agree to comply with all terms and conditions set out in this policy.',
			},
			{
				number: '2',
				title: 'Changes to Terms',
				body: 'RS Krakatau Medika reserves the right to change or update these terms and conditions from time to time without prior notice. Changes take effect immediately upon publication on the website.',
			},
			{
				number: '3',
				title: 'Use of the Website',
				body: 'This website is provided for informational purposes regarding RS Krakatau Medika healthcare services. Users are prohibited from:',
				items: [
					'Using the website for illegal or unauthorised purposes',
					'Interfering with or compromising website security',
					'Copying, distributing, or modifying content without written permission',
					'Using the website to spread viruses or malware',
				],
			},
			{
				number: '4',
				title: 'Intellectual Property Rights',
				body: 'All content on this website, including text, images, logos, and trademarks, is the property of RS Krakatau Medika or its licensors and is protected by applicable intellectual property laws.',
			},
			{
				number: '5',
				title: 'Disclaimer',
				body: 'RS Krakatau Medika does not guarantee that this website is free from errors or technical interruptions. The information provided is general in nature and does not replace direct medical consultation with a healthcare professional.',
			},
			{
				number: '6',
				title: 'Third-Party Links',
				body: 'This website may contain links to third-party websites. RS Krakatau Medika is not responsible for the content, privacy policies, or practices of those third-party websites.',
			},
			{
				number: '7',
				title: 'Limitation of Liability',
				body: 'To the extent permitted by law, RS Krakatau Medika will not be liable for indirect, incidental, special, consequential, or punitive damages arising from the use of, or inability to use, this website.',
			},
			{
				number: '8',
				title: 'Governing Law',
				body: 'These terms and conditions are governed by the laws of Indonesia. Any dispute arising in connection with these terms and conditions will be resolved through the competent courts within the jurisdiction of RS Krakatau Medika.',
			},
			{
				number: '9',
				title: 'Contact Us',
				body: 'For further questions regarding these terms and conditions, please contact us at {email}.',
				email: 'info@krakataumedika.co.id',
			},
		],
	},
} as const;

const data = content[lang];
---

<section class="section">
  <div class="container terms">
    <h1 class="terms__title">{t('page.title.terms')}</h1>

		<div class="terms__content">
			{data.sections.map((section) => (
				<>
					<h2>{section.number}. {section.title}</h2>
					{'email' in section ? (
						<p>
							{section.body.split('{email}')[0]}
							<a href={`mailto:${section.email}`}>{section.email}</a>
							{section.body.split('{email}')[1]}
						</p>
					) : (
						<p>{section.body}</p>
					)}
					{'items' in section && (
						<ul>
							{section.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					)}
				</>
			))}
		</div>
	</div>
</section>

<style>
  .terms {
    max-width: 48rem;
    margin: 0 auto;
  }

  .terms__title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-6);
  }

  .terms__content {
    display: grid;
    gap: var(--space-6);
  }

  .terms__content h2 {
    font-size: var(--text-xl);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    color: var(--color-ink);
  }

  .terms__content p {
    color: var(--color-body);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-4);
  }

  .terms__content ul {
    padding-left: var(--space-6);
    margin-bottom: var(--space-4);
    display: grid;
    gap: var(--space-2);
  }

  .terms__content li {
    color: var(--color-body);
    line-height: var(--leading-normal);
  }

  .terms__content a {
    color: var(--color-primary-text);
    text-decoration: underline;
  }
</style>
