---
/**
 * Isi halaman /about — dipakai bersama oleh root (id) & [lang] (en).
 * Konten visi/misi/nilai spesifik halaman ini → ditulis di sini
 * per locale (dipakai 1x per bahasa), bukan di data/.
 */
import Card from '@/components/ui/Card.astro';
import CTASection from '@/components/sections/CTASection.astro';
import PageHero from '@/components/ui/PageHero.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { tFactory, type Lang } from '@/i18n';
import { ABOUT_DATA } from '@/data/about';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = tFactory(lang);

const { vision, misi, values } = ABOUT_DATA[lang];
---

<PageHero
  eyebrow={t('pagehero.eyebrow.about')}
  title={t('aboutPage.hero.title')}
  lead={t('aboutPage.hero.lead')}
/>

<section class="section">
  <div class="container">
    <SectionHeading
      eyebrow={t('aboutPage.visionMisi.eyebrow')}
      title={t('aboutPage.visionMisi.title')}
      align="start"
    />
    <div class="about__grid">
      <Card>
        <h3 class="about__card-title">{t('aboutPage.vision')}</h3>
        <p>{vision}</p>
      </Card>
      <Card>
        <h3 class="about__card-title">{t('aboutPage.mission')}</h3>
        <ul class="about__list" role="list">
          {misi.map((item) => <li>{item}</li>)}
        </ul>
      </Card>
    </div>
  </div>
</section>

<section class="section section--alt">
  <div class="container">
    <SectionHeading
      eyebrow={t('aboutPage.values.eyebrow')}
      title={t('aboutPage.values.title')}
      lead={t('aboutPage.values.lead')}
    />
    <div class="about__values">
      {
        values.map((value) => (
          <Card>
            <h3 class="about__card-title">{value.title}</h3>
            <p class="about__value-description">{value.description}</p>
          </Card>
        ))
      }
    </div>
  </div>
</section>

<CTASection lang={lang} />

<style>
  .about__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-6);
  }

  .about__values {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-6);
  }

  .about__card-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .about__list {
    padding-left: var(--space-4);
    display: grid;
    gap: var(--space-2);
  }

  .about__value-description {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
